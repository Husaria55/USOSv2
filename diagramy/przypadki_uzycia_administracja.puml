@startuml przypadki_uzycia_administracja
!pragma layout smetana
left to right direction
title Przypadki użycia (2/2) – dziekanat, prowadzący, zegar
skinparam shadowing false

actor "Administrator\n(dziekanat)" as A
actor "Prowadzący" as P
actor "Zegar systemowy" as Z

rectangle "System zapisów" {
  usecase "//Operacja pracownika//" as OPP
  usecase "UC0: Uwierzytelnij się" as UC0
  usecase "UC10: Przeglądaj listy\nstudentów swoich grup" as UC10
  usecase "UC11: Zarządzaj kursami\ni wymaganiami wstępnymi" as UC11
  usecase "UC12: Zarządzaj grupami,\nsalami i harmonogramem" as UC12
  usecase UC13 as "UC13: Zmień limit miejsc w grupie
--
extension points:
wolne miejsce po zmianie"
  usecase UC14 as "UC14: Zapisz / wypisz studenta
(decyzja dziekanatu)
--
extension points:
wypis w otwartej turze"
  usecase "UC15: Importuj zaliczone\nprzedmioty" as UC15
  usecase "UC16: Otwórz / zamknij\nturę ręcznie" as UC16
  usecase "UC17: Otwórz / zamknij turę\no zadanej godzinie" as UC17
  usecase "UC18: Wygaś listy\noczekujących" as UC18
  usecase "UC4: Wykryj kolizję\nw planie" as UC4
  usecase "UC9: Awansuj pierwszego\nz listy oczekujących" as UC9
}

P -- UC10
A -- UC11
A -- UC12
A -- UC13
A -- UC14
A -- UC15
A -- UC16
Z -- UC17

UC10 --|> OPP
UC11 --|> OPP
UC12 --|> OPP
UC13 --|> OPP
UC14 --|> OPP
UC15 --|> OPP
UC16 --|> OPP
OPP ..> UC0 : <<include>>

UC12 ..> UC4 : <<include>>\n(sala, prowadzący)
UC14 ..> UC4 : <<include>>
UC9 ..> UC13 : <<extend>>
UC9 ..> UC14 : <<extend>>
UC16 ..> UC18 : <<include>>\n(przy zamknięciu)
UC17 ..> UC18 : <<include>>\n(przy zamknięciu)

note bottom of UC14
  Dziekanat może pominąć wymagania
  wstępne i działać poza turą. Zapis do
  pełnej grupy zwiększa jej limit o 1
  (nie ponad liczbę miejsc w sali).
end note
@enduml
