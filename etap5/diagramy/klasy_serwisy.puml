@startuml klasy_serwisy
!include _klasy.iuml
title Projekt klas – serwisy logiki biznesowej (otrzymany projekt + etap 5)

class EnrollmentService <<zmieniona>> {
  + enroll(student_id: int, section_id: int, ip: str): ResultDTO
  + drop_section(student_id: int, section_id: int, ip: str): bool
  + get_student_schedule(student_id: int, term_id: int): list[StudentScheduleItemDTO]
  <color:#1B7F3B>**- _lock_student(student_id: int): User**</color>
}
class WaitingListService <<zmieniona>> {
  + join_waitlist(student_id: int, section_id: int, ip: str): int
  + leave_waitlist(student_id: int, section_id: int, ip: str): bool
  + on_seat_freed(section_id: int): int
  + promote_next(section_id: int, excluded_ids: list[int]): WaitlistPromotionStatus
}
class EnrollmentRuleEngine <<zmieniona>> {
  + check_rules(student_id: int, section_id: int): Optional[RuleViolationDTO]
  + verify_prerequisites(student_id: int, course_id: int): list[Course]
  + has_schedule_conflict(student_id: int, section_id: int): list[Section]
  + is_already_enrolled_in_course(student_id, course_id, term_id): bool
  <color:#1B7F3B>**+ find_schedule_conflicts(section_id: int, new_slots: list[ScheduleSlot], student_ids: list[int]): list[ConflictDTO]**</color>
}
class CatalogService <<zmieniona>> {
  + search_sections(term_id, query, lecturer_id, day_of_week): list[SectionCatalogDTO]
  + get_available_seats(section_id: int): int
  + create_or_update_section(data: SectionDTO, admin_id: int, ip: str): Section  <color:#1B7F3B>**{STUDENT_CONFLICT}**</color>
  + configure_enrollment_window(term_id, start, end, <color:#1B7F3B>**mode: EnrollmentMode, points_budget: int?**</color>, admin_id, ip): Term
  + update_section_capacity(section_id, new_cap, admin_id, ip): Section
  + create_or_update_course(data: CourseDTO, admin_id, ip): Course
  + create_or_update_lecturer(data: LecturerDTO, admin_id, ip): Lecturer
}
class AuditLogService {
  + log_action(user_id, action, ip: Opt[str] = "SYSTEM", details): None
}
class SSOAuthService {
  + get_authorization_url(): tuple[str, str]
  + handle_sso_callback(code, state, ip): AuthTokenDTO
  + provision_or_update_user(claims): User
  + verify_session_token(token: str): User
  + logout(token: str, user_id: int, ip: str): None
}
class PreferenceService <<nowa>> {
  + save_preferences(student_id: int, term_id: int, prefs: list[PreferenceDTO], ip: str): PreferenceSaveResultDTO
  + get_preferences(student_id: int, term_id: int): list[PreferenceDTO]
  + validate(prefs: list[PreferenceDTO], term: Term, sections: dict[int, Section]): list[RuleViolationDTO]
}
class AllocationService <<nowa>> {
  + run_allocation(term_id: int, kind: AllocationKind, seed: int? = None): AllocationRunDTO
  + get_student_allocation(student_id: int, term_id: int): AllocationViewDTO
  + get_report(term_id: int): AllocationReportDTO
  + terms_to_finalize(now: datetime): list[int]
}
class PreferenceAllocator <<nowa>> {
  + allocate(requests: list[CourseRequest], profiles: dict[int, StudentProfile],
      sections: dict[int, SectionOffer], prerequisites: dict[int, dict[int, str]], seed: int): AllocationResult
  + verify(result: AllocationResult, ...): list[str]
  + options_for(request, profile, sections, prerequisites): list[Option] | Rejection
  + rank_factor(rank: int): float
}
class "Zadania Celery" as tasks <<nowa>> {
  + on_seat_freed(section_id)  (bez zmian)
  <color:#1B7F3B>**+ preview_allocations()  – Celery Beat co 5 min**</color>
  <color:#1B7F3B>**+ finalize_allocations()  – Celery Beat co 1 min**</color>
}

EnrollmentService --> EnrollmentRuleEngine
EnrollmentService --> AuditLogService
WaitingListService --> EnrollmentRuleEngine
WaitingListService --> AuditLogService
CatalogService --> EnrollmentRuleEngine : find_schedule_conflicts
CatalogService --> AuditLogService
PreferenceService --> EnrollmentRuleEngine : ostrzeżenia
PreferenceService --> AuditLogService
AllocationService --> PreferenceAllocator
AllocationService --> AuditLogService
tasks --> WaitingListService
tasks --> AllocationService
SSOAuthService -[hidden]down- PreferenceService
tasks -[hidden]down- WaitingListService
EnrollmentService -[hidden]down- EnrollmentRuleEngine
@enduml
