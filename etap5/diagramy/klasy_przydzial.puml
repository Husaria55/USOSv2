@startuml klasy_przydzial
!pragma layout smetana
title Diagram klas (2/4) – domena: przydział według preferencji (app/domain/allocation.py)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11
hide empty members

package "dane wejściowe" {
  class CourseRequest <<dataclass, frozen>> {
    + student_id: int
    + course_id: int
    + course_code: str
    + weight: int  {punkty z puli}
    + choices: Mapping[str, tuple[int, ...]]  {typ zajęć -> grupy wg rangi}
    + key: (student_id, course_id)  {property}
  }
  class StudentProfile <<dataclass, frozen>> {
    + student_id: int
    + plan: tuple[PlanEntry, ...]
    + passed_course_ids: frozenset[int]
  }
  class Offer <<dataclass, frozen>> {
    + section_id: int
    + course_id: int
    + kind: str
    + label: str
    + slots: tuple[Slot, ...]
    + free_seats: int
  }
  class PreferenceInput <<dataclass, frozen>> {
    + course_id: int
    + weight: int
    + section_ids: tuple[int, ...]
  }
  class SectionInfo <<dataclass, frozen>> {
    + id, course_id: int
    + kind: str
    + term_id: int
  }
}

package "wynik" {
  class Option <<dataclass, frozen>> {
    + section_ids: tuple[int, ...]
    + ranks: tuple[int, ...]
    + utility: float
    + slots: tuple[Slot, ...]
    + mask: int  {time_mask(slots)}
  }
  class AllocationResult <<dataclass, frozen>> {
    + assignments: tuple[Assignment, ...]
    + unassigned: tuple[Unassigned, ...]
    + total_utility: float
    + upper_bound: float
    + improvements: int
    + seed: int
    + requests: int  {property}
  }
  class Assignment <<dataclass, frozen>> {
    + student_id, course_id, weight: int
    + section_ids: tuple[int, ...]
    + utility: float
  }
  class Unassigned <<dataclass, frozen>> {
    + student_id, course_id, weight: int
    + reason: Rejection
  }
  class Rejection <<dataclass, frozen>> {
    + code: str  {PREREQUISITES | CONFLICT | ALREADY_ENROLLED |\nNO_SECTIONS | FULL | OWN_CONFLICT | BUDGET_EXCEEDED ...}
    + message: str
    + details: tuple[str, ...]
  }
}

class allocation <<module>> {
  + rank_factor(rank: int): float  {max(0.5, 1 - 0.1 (rank - 1))}
  + utility(weight: int, ranks): float
  + time_mask(slots): int
  + options_for(request, profile, offers, prerequisites): list[Option] | Rejection
  + allocate(requests, profiles, offers, prerequisites, seed: int, improve: bool = True): AllocationResult
  + verify(result, requests, profiles, offers, prerequisites): list[str]
  + validate_preferences(items: list[PreferenceInput], budget: int, term_id: int, sections): list[Rejection]
  + choices_by_kind(section_ids, sections): dict[str, tuple[int, ...]]
}

class _State <<wewnętrzna>> {
  - free: dict[int, int]
  - chosen: dict[Key, Option]
  - busy: dict[int, int]  {maska zajętych minut studenta}
  - holders: dict[int, set[Key]]
  - journal: list  {dziennik zmian}
  - total: float
  + place(key, opt) / remove(key)
  + mark(): int / rollback(mark)
  + fits(key, opt): bool
  + own_conflicts(key, opt): list[Key]
}

allocation ..> CourseRequest
allocation ..> StudentProfile
allocation ..> Offer
allocation ..> Option : tworzy
allocation ..> AllocationResult : zwraca
allocation ..> _State : _try_insert, _make_room, _refill
allocation ..> PreferenceInput
allocation ..> SectionInfo
AllocationResult o-- "0..*" Assignment
AllocationResult o-- "0..*" Unassigned
Unassigned --> Rejection
_State o-- "0..*" Option

note bottom of allocation
  Cel: max Σ u(przydział) przy limitach miejsc, braku kolizji,
  wymaganiach wstępnych i jednej grupie danego typu z przedmiotu.
  Kroki: wykonalność → zachłannie (waga, los z seed) → poprawa lokalna.
  Jakość (1000 losowych instancji vs przegląd zupełny): średnio 99,8% optimum.
end note
@enduml
